# Brain + UI in Docker (root docker-compose.yaml env_file).
# Secrets / overrides: copy repo-root .env.example → .env (optional second env_file on brain).
#
# Local brain on host (uv): use .env.example — not this file.
# Fleet agent: provision-vm writes repo-root .env (see ia-infra-recipe/fleet.env).

MODEL_PROVIDER=litellm
LITELLM_PROXY_BASE=http://host.docker.internal:4000
LITELLM_MASTER_KEY=sk-datasyn-local-litellm-dev
LITELLM_KEY=sk-datasyn-local-litellm-dev
CHAT_MODEL=local/gemini-2.0-flash

# Dagster UI/GraphQL from brain container on infra-datasynk
DAGSTER_URL=http://dagster_webserver:3000

# MCP: brain in Docker can rewrite mcp.json hostnames to published ports (default).
# Fleet: set MCP_DISABLE_HOST_URL_REWRITE=1 and use remote IPs in mcp.json.

# Optional tracing — see .env.example (Langfuse block)
