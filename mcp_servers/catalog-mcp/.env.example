# Preferred: single URL (matches docker-compose catalog-mcp service).
DATABASE_URL=postgresql://datacyber:datacyber@localhost:5432/datacyber_catalog

# Or discrete vars (local dev without DATABASE_URL):
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_USER=datacyber
# POSTGRES_PASSWORD=datacyber
# POSTGRES_DB=datacyber_catalog

HOST=0.0.0.0
PORT=8041
MCP_HTTP_PATH=/mcp

# For list_uncataloged_warehouse_tables: same file as duckdb-mcp (read-only).
# DUCKDB_PATH=/data/warehouse.duckdb
# WAREHOUSE_FQN_PREFIX=duckdb-warehouse
