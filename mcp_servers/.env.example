# Copy to `.env` in this directory (`mcp_servers/.env`) to enable optional compose profiles
# when using `docker compose -f mcp_servers/docker-compose.yaml` (project dir = `mcp_servers/`).
#
# DuckDB Local UI (`duckdb-ui` service — profile `ui`). Uncomment to always include it on `up`:
# COMPOSE_PROFILES=ui

# Dagster MCP — extra `docker run -v` mounts for `dagster_deploy` (semicolon-separated;
# paths are on the Docker **host**). Needed so Dagster project containers see
# `warehouse.duckdb` and `/data-local` (INDEC TXT + metadata.json).
# Example (replace the bind path with your repo’s `data-local`):
# DAGSTER_DEPLOY_VOLUMES=duckdb_data:/data;storage:/storage;/Users/you/project/datacyber/data-local:/data-local:ro
# DAGSTER_DUCKDB_PATH=/data/warehouse.duckdb
#
# Metadata catalog (PostgreSQL): dagster-mcp exposes `catalog_get_schema` / `catalog_execute_query`
# (brain sees `dagster_catalog_*`). Set one of:
# DATABASE_URL=postgresql://datacyber:datacyber@catalog-db:5432/datacyber_catalog
# CATALOG_DATABASE_URL=postgresql://datacyber:datacyber@catalog-db:5432/datacyber_catalog
#
# Passed through to user-code containers on `dagster_deploy` (INDEC EPH catalog sync asset):
# INDEC_EPH_BASE=/data-local/indec/mercado_laboral/EPH
#
# Scrapper → MinIO (``infra/object-storage`` service ``minio``, not Langfuse). Must match
# ``MINIO_ROOT_USER`` / ``MINIO_ROOT_PASSWORD`` in ``infra/object-storage/.env`` if you
# changed them; defaults are minioadmin / minioadmin123.
# SCRAPPER_MINIO_ACCESS_KEY=minioadmin
# SCRAPPER_MINIO_SECRET_KEY=minioadmin123
# MINIO_ENDPOINT=http://datacyber-object-minio:9000
# MINIO_BUCKET=data-local
# MINIO_SECURE=false
#
# Dagster MCP — ``compose_force_recreate`` / ``user_code_refresh`` (recreate host
# ``dagster_user_code`` after building ``dagster_user_code_image`` from ``datasynk``):
# Defaults in ``mcp_servers/docker-compose.yaml`` mount ``../infra/dagster`` →
# ``/dagster-compose`` and set:
#   DAGSTER_COMPOSE_FILE=/dagster-compose/docker-compose.yaml
#   DAGSTER_COMPOSE_PROJECT=dagster
# Override only if your compose path or project name differs.
# DAGSTER_COMPOSE_FILE=/dagster-compose/docker-compose.yaml
# DAGSTER_COMPOSE_PROJECT=dagster
# DAGSTER_USER_CODE_BUILD_PROJECT=datasynk
# DAGSTER_USER_CODE_IMAGE_NAME=dagster_user_code_image
