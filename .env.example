# Copy to `.env` at the repo root (gitignored) for local brain dev:
#   cp .env.example .env
#
# Always use uv (do not use bare python/pip on the host):
#   uv sync && make agent-dev
#   uv run brain-dev          # brain only (hot reload)
#   make brain-restart        # kill :8002 + uv run brain-dev (after .env edits)
#
# UI: http://127.0.0.1:5173  ·  Brain: http://127.0.0.1:8002

# --- LLM (pick one MODEL_PROVIDER) ---

# OpenRouter (simplest for local Mac)
MODEL_PROVIDER=openrouter
OPENROUTER_API_KEY=
CHAT_MODEL=google/gemini-2.0-flash-001

# Gemini direct
# MODEL_PROVIDER=gemini
# GEMINI_API_KEY=
# CHAT_MODEL=gemini-2.0-flash

# LiteLLM proxy (self-hosted or remote)
# MODEL_PROVIDER=litellm
# LITELLM_KEY=
# LITELLM_PROXY_BASE=http://127.0.0.1:4000
# CHAT_MODEL=local/gemini-2.0-flash

# --- MCP (external servers in mcp.json) ---

# Use raw URLs from mcp.json (required when pointing to a remote host/IP, not Docker DNS).
MCP_DISABLE_HOST_URL_REWRITE=1

# --- Dagster GraphQL (Datasets tab) ---

DAGSTER_GRAPHQL_URL=http://127.0.0.1:3001/graphql

# --- Local dev ports ---

API_PORT=8002
VITE_PROXY_TARGET=http://127.0.0.1:8002
