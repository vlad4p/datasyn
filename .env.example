# Copy to `.env` at the repo root (gitignored) for local brain dev:
#   cp .env.example .env
# Fleet / prod deploy: cp .env.deploy.example .env
#
# Always use uv (do not use bare python/pip on the host):
#   uv sync && make agent-dev
#   uv run brain-dev          # brain only (hot reload)
#   make brain-restart        # kill :8002 + uv run brain-dev (after .env edits)
#
# UI: http://127.0.0.1:5173  ·  Brain: http://127.0.0.1:8002

# --- LLM (pick one MODEL_PROVIDER) ---

# LiteLLM proxy (default for datasyn-brain)
MODEL_PROVIDER=litellm
LITELLM_KEY=
LITELLM_MASTER_KEY=
LITELLM_PROXY_BASE=http://127.0.0.1:4000
CHAT_MODEL=local/gemini-2.0-flash

# OpenRouter (alternative for local Mac without LiteLLM)
# MODEL_PROVIDER=openrouter
# OPENROUTER_API_KEY=
# CHAT_MODEL=meta-llama/llama-3.3-70b-instruct:free
# CHAT_MODEL_FAST=google/gemini-2.0-flash-exp:free
# Optional provider prompt-cache hint (LiteLLM/OpenRouter extra_body; provider-dependent)
# LITELLM_ENABLE_PROMPT_CACHE=1
# Subagent prompt: compact playbook (default). Set 1 to inject full AGENTS.md (~40k chars).
# DATASYN_SUBAGENT_FULL_AGENTS_MD=0

# Gemini direct
# MODEL_PROVIDER=gemini
# GEMINI_API_KEY=
# CHAT_MODEL=gemini-2.0-flash

# LiteLLM proxy (self-hosted or remote) — see block above for defaults
# LITELLM_KEY=
# LITELLM_PROXY_BASE=http://127.0.0.1:4000
# CHAT_MODEL=local/gemini-2.0-flash

# --- MCP (external servers in mcp.json; see mcp.json.example) ---

# 0 = rewrite mcp.json hostnames to localhost ports (local Docker). 1 = use URLs as-is (fleet IPs).
# MCP_DISABLE_HOST_URL_REWRITE=0

# --- Skills sync (LiteLLM Skills Gateway; independent of MODEL_PROVIDER) ---
# Push/pull use LITELLM_PROXY_BASE (default http://127.0.0.1:4000) and LITELLM_KEY.
# If unset, skills-sync falls back to infra/litellm/.env → LITELLM_MASTER_KEY.
# SKILLS_SOURCE=local
# LITELLM_KEY=sk-datasyn-local-litellm-dev
# LITELLM_PROXY_BASE=http://127.0.0.1:4000
# LITELLM_SKILLS_STATIC_BASE=http://127.0.0.1:4001
# LITELLM_SKILLS_BUNDLE_DIR=./infra/litellm/skills-bundles

# --- Dagster (Datasets tab) ---

# Optional: absolute host path for ``data-local`` bind mount in ``infra/dagster/docker-compose.yaml``
# (default ``../../data-local`` relative to that compose file). Also edit
# ``infra/dagster/runtime/dagster.yaml`` for DockerRunLauncher per-run containers.
# DATASYN_DATA_LOCAL_HOST=/path/to/datasyn/data-local

# Webserver host + port only; GraphQL path (/graphql) is appended in agent/config.py.
#
# Local brain on host (uv run brain-dev): Dagster published on host :3001 → use loopback.
# DAGSTER_URL=http://127.0.0.1:3001
#
# Brain in Docker (root docker-compose on infra-datasynk): use the webserver service
# name and container port 3000 — NOT dagster_daemon, NOT localhost, NOT host :3001.
DAGSTER_URL=http://dagster_webserver:3000

# --- Local dev ports ---

API_PORT=8002
VITE_PROXY_TARGET=http://127.0.0.1:8002

# --- Langfuse tracing (optional) ---
# 1) Start Langfuse: make -C infra/langfuse-deploy up
# 2) Uncomment keys below (match LANGFUSE_INIT_* in infra/langfuse-deploy/.env.datasyn.example)
# 3) make brain-restart  (or restart make agent-dev)
#
# Brain on host → loopback URLs. Brain in Docker → use host.docker.internal:3000 instead.
# LANGFUSE_PUBLIC_KEY=pk-lf-datasyn-local-dev
# LANGFUSE_SECRET_KEY=sk-lf-datasyn-local-dev
# LANGFUSE_BASE_URL=http://127.0.0.1:3000
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:3000/api/public/otel
# OTEL_SERVICE_NAME=datasyn-brain
# DEPLOYMENT_ENV=dev

# --- OAuth login (optional) ---
# Auth auto-enables when OAUTH_SESSION_SECRET is set and at least one provider is configured.
# Set AUTH_ENABLED=false to disable even when credentials are present.
#
# Vite dev UI (http://localhost:5173) — register these redirect URIs in Google/GitHub:
#   http://localhost:5173/api/auth/callback/google
#   http://localhost:5173/api/auth/callback/github
# Docker UI (http://localhost:8003):
#   http://localhost:8003/api/auth/callback/google
#   http://localhost:8003/api/auth/callback/github
#
# OAUTH_SESSION_SECRET=change-me-to-a-long-random-string
# OAUTH_REDIRECT_BASE_URL=http://localhost:5173/api
# OAUTH_UI_REDIRECT_URL=/
# OAUTH_GOOGLE_CLIENT_ID=
# OAUTH_GOOGLE_CLIENT_SECRET=
# OAUTH_GITHUB_CLIENT_ID=
# OAUTH_GITHUB_CLIENT_SECRET=
# AUTH_ENABLED=true
