# Copy to `.env` (gitignored):  cp .env.example .env
#
# Host dev:     uv sync && make agent-dev
# Build/push:   set DATASYN_IMAGE_REGISTRY, then make build-agent build-ui && make push
# VM Docker:    copy this file + docker-compose.yaml; set host.docker.internal URLs below

# --- Docker images ---
# DATASYN_IMAGE_REGISTRY=10.13.10.123:5000
DATASYN_IMAGE_NAMESPACE=datasyn
DATASYN_IMAGE_TAG=latest
# Build for fleet VM (amd64). Override on Apple Silicon local compose: linux/arm64
# DATASYN_DOCKER_PLATFORM=linux/amd64

# --- LLM (pick one MODEL_PROVIDER) ---
MODEL_PROVIDER=litellm
LITELLM_KEY=
LITELLM_MASTER_KEY=
# Host dev: http://127.0.0.1:4000  |  Docker/VM: http://host.docker.internal:4000
LITELLM_PROXY_BASE=http://127.0.0.1:4000
CHAT_MODEL=local/gemini-2.0-flash

# MODEL_PROVIDER=openrouter
# OPENROUTER_API_KEY=

# MODEL_PROVIDER=gemini
# GEMINI_API_KEY=

# --- MCP (see mcp.json.example) ---
# MCP_DISABLE_HOST_URL_REWRITE=0

# --- Skills sync ---
# SKILLS_SOURCE=local
# LITELLM_SKILLS_STATIC_BASE=http://127.0.0.1:4001
# LITELLM_SKILLS_BUNDLE_DIR=/path/to/skills-bundles

# --- Dagster ---
# Host dev: http://127.0.0.1:3001  |  Docker/VM: http://host.docker.internal:3001
DAGSTER_URL=http://127.0.0.1:3001

# --- Host dev ports ---
API_PORT=8002
VITE_PROXY_TARGET=http://127.0.0.1:8002

# --- Langfuse (optional) ---
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_BASE_URL=http://127.0.0.1:3000

# --- OAuth (required before exposing brain to the internet) ---
# OAUTH_SESSION_SECRET=
# OAUTH_REDIRECT_BASE_URL=http://localhost:5173/api
# OAUTH_GOOGLE_CLIENT_ID=
# OAUTH_GOOGLE_CLIENT_SECRET=
# OAUTH_GITHUB_CLIENT_ID=
# OAUTH_GITHUB_CLIENT_SECRET=

# --- Quack sync (external DuckDB → main warehouse via MCP) ---
# See config/sync_sources.yaml and skills/sync-duckdb-quack/SKILL.md
# Main warehouse Quack (Dagster / docs; Brain sync uses duckdb MCP):
# QUACK_URI=quack:10.13.10.119:9494
# QUACK_TOKEN=
# QUACK_ALIAS=warehouse
# QUACK_DISABLE_SSL=true
# Default target schema for synced tables:
# SYNC_TARGET_SCHEMA=bronze
# Per-source credentials (name "external" in sync_sources.yaml):
# SYNC_EXTERNAL_QUACK_URI=quack:10.13.10.200:9494
# SYNC_EXTERNAL_QUACK_TOKEN=
# Or short aliases when source name is exactly "external":
# EXTERNAL_QUACK_URI=quack:10.13.10.200:9494
# EXTERNAL_QUACK_TOKEN=
