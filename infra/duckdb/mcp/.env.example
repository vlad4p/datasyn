# duckdb-mcp — copy to mcp/.env (provision-vm writes fleet values automatically)

HOST=0.0.0.0
PORT=8040
MCP_HTTP_PATH=/mcp
DUCKDB_PATH=/data/warehouse.duckdb
SQL_ROW_CAP=500
DATA_LOCAL_ROOT=/data-local

# Quack remote protocol (Dagster and other clients attach here)
QUACK_BIND_URI=quack:0.0.0.0:9494
QUACK_TOKEN=MY_QUACK_TOKEN_01234567890ABCDEF
QUACK_ENABLE=true

# MinIO for DuckDB httpfs (local: datasyn-object-minio on infra-datasynk)
MINIO_ENDPOINT=http://datasyn-object-minio:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_SECURE=false

# Fleet: MINIO_ENDPOINT=http://10.13.10.120:9000
