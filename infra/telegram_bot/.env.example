# Copy to .env and fill in (see root .gitignore — .env is not committed).

# From @BotFather
TELEGRAM_BOT_TOKEN=

# Brain HTTP base (no trailing slash). Same Docker stack: http://brain:8000
# Host dev: http://host.docker.internal:8002
BRAIN_BASE_URL=http://brain:8000

# Assistant reply language, same as UI: en | es
TELEGRAM_REPLY_LOCALE=en

# Optional: comma-separated Telegram user IDs. If empty, any user may chat.
# TELEGRAM_ALLOWED_USER_IDS=123456789,987654321

# HTTP timeout for /agent/chat (seconds). Agent turns can be long.
BRAIN_HTTP_TIMEOUT_SECONDS=600
