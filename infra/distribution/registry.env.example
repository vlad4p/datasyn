# Copy to ``registry.env`` and pass ``docker compose --env-file …`` if you do not use the Makefile
# (which exports these variables). Defaults match the Makefile.
#
# REGISTRY_PUBLISH_PORT=5000
# DATASYN_IMAGE_REGISTRY=localhost:5000
# DATASYN_IMAGE_NAMESPACE=datasyn
# DATASYN_IMAGE_TAG=latest

REGISTRY_PUBLISH_PORT=5000
DATASYN_IMAGE_REGISTRY=localhost:5000
DATASYN_IMAGE_NAMESPACE=datasyn
DATASYN_IMAGE_TAG=latest

# Remote registry (push from laptop, e.g. Apple Silicon → linux/amd64 server):
#   export DATASYN_IMAGE_REGISTRY=10.13.10.119:5000
# Push storage-mcp: ``make storage-mcp-build-push-remote DATASYN_IMAGE_REGISTRY=10.13.10.119:5000``
#   (uses BuildKit ``infra/distribution/buildkit-registry-insecure.toml`` so HTTP works without
#   Docker Engine ``insecure-registries`` for buildx).
# Probe API: ``make registry-api-v2 REGISTRY_HTTP_URL=http://10.13.10.119:5000``
# Full stack (all compose images) build + push to external registry (no local distribution container):
#   make publish-remote DATASYN_IMAGE_REGISTRY=10.13.10.119:5000
# HTTP: add host:port to Docker ``insecure-registries`` for ``docker compose push``, or push may fail.
# Override platform: ``make publish-remote ... DOCKER_PLATFORM_REMOTE=linux/arm64``
