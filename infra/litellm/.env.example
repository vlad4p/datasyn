# Copy to /opt/litellm/.env on the instance (bootstrap creates a placeholder if missing).
# https://docs.litellm.ai/docs/proxy/deploy
#
# Local docker-compose: Postgres is on host 127.0.0.1:5434 (Langfuse uses 5432). The proxy still uses DATABASE_URL inside compose (db:5432).

LITELLM_MASTER_KEY=sk-your-admin-key-must-start-with-sk
LITELLM_SALT_KEY=long-random-secret-do-not-change-after-models-added
STORE_MODEL_IN_DB=true

# Langfuse v3 (OpenTelemetry) — required if config.yaml uses callbacks: ["langfuse_otel"]
# Create API keys in Langfuse: Project Settings → API Keys
# https://docs.litellm.ai/docs/observability/langfuse_otel_integration
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
# Base URL only (no /api/public/otel); LiteLLM adds that path. Examples:
# Cloud US: https://us.cloud.langfuse.com
# Cloud EU: https://cloud.langfuse.com
# Langfuse on host / other machine: https://langfuse.example.com
# Local: Langfuse reachable from this container (docker-compose sets host.docker.internal on Linux):
LANGFUSE_OTEL_HOST=http://host.docker.internal:3000
