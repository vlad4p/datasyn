# LiteLLM proxy for hosts without x86-64-v2 (legacy Proxmox / QEMU virtual CPU).
# Use: make -C infra/litellm up LEGACY_CPU=1
FROM python:3.12-slim-bookworm
RUN apt-get update \
    && apt-get install -y --no-install-recommends nodejs npm \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
RUN pip install --no-cache-dir "litellm[proxy]" psycopg2-binary python-dotenv prisma \
    && prisma generate --schema=/usr/local/lib/python3.12/site-packages/litellm/proxy/schema.prisma
COPY config/config.yaml /app/config.yaml
EXPOSE 4000
CMD ["litellm", "--config", "/app/config.yaml", "--port", "4000"]
