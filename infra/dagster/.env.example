# Dagster stack env — copy: cp .env.example .env
# Regenerate runtime config after edits: make -C infra/dagster patch-runtime
#
# Prod image pull: repo-root .env from .env.deploy.example
# Fleet IPs: ia-infra-recipe/fleet.env (provision-vm writes this file on VM 122)

# --- Local dev (stacks on Docker network infra-datasynk) ---

# DuckDB warehouse via Quack on duckdb-mcp (not DUCKDB_PATH — Dagster does not mount warehouse.duckdb)
QUACK_URI=quack:duckdb-mcp:9494
QUACK_TOKEN=MY_QUACK_TOKEN_01234567890ABCDEF
QUACK_DISABLE_SSL=true

MINIO_ENDPOINT=http://datasyn-object-minio:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET=data-local
MINIO_SECURE=false

# LiteLLM on host or litellm compose service
LITELLM_PROXY_BASE=http://host.docker.internal:4000
LITELLM_MASTER_KEY=sk-datasyn-local-litellm-dev
LITELLM_KEY=sk-datasyn-local-litellm-dev

DATA_LOCAL_ROOT=/data-local
# Absolute host path for DockerRunLauncher /data-local bind mount (required on fleet VMs).
# Local dev: leave empty — ``make up`` defaults to ``<repo>/data-local``.
DATASYN_DATA_LOCAL_HOST=

# --- Fleet (uncomment and adjust; or use provision-vm.sh dagster) ---
# QUACK_URI=quack:10.13.10.119:9494
# MINIO_ENDPOINT=http://10.13.10.120:9000
# LITELLM_PROXY_BASE=http://10.13.10.121:4000
# LITELLM_MASTER_KEY=sk-datasyn-fleet-litellm-dev
# LITELLM_KEY=sk-datasyn-fleet-litellm-dev
# DATASYN_DATA_LOCAL_HOST=/home/user/datasyn/data-local

# --- Optional: Iceberg REST (leave unset unless using attach_iceberg_catalog) ---
# ICEBERG_REST_ENDPOINT=
# ICEBERG_REST_TOKEN=
# ICEBERG_REST_WAREHOUSE=
# ICEBERG_ATTACH_ALIAS=
# ICEBERG_REST_SECRET_NAME=
# ICEBERG_REST_CLIENT_ID=
# ICEBERG_REST_CLIENT_SECRET=
# ICEBERG_REST_OAUTH_URI=
