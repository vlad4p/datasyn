# Optional overrides for the ``dagster-mcp`` container (copy to ``infra/dagster/.env`` or set in shell).
# Compose already loads ``infra/dagster/.env`` for this service.

# Extra ``docker run -v`` mounts for ``dagster_deploy`` (semicolon-separated host paths).
# Example (replace bind with your repo ``data-local``):
# DAGSTER_DEPLOY_VOLUMES=duckdb_data:/data;storage:/storage;/Users/you/project/datacyber/data-local:/data-local:ro

# Metadata catalog (PostgreSQL): ``dagster_catalog_*`` tools
# DATABASE_URL=postgresql://datacyber:datacyber@catalog-db:5432/datacyber_catalog
# CATALOG_DATABASE_URL=postgresql://...

# ``compose_force_recreate`` / ``user_code_refresh`` (defaults match ``infra/dagster/docker-compose.yaml``):
# DAGSTER_COMPOSE_FILE=/dagster-compose/docker-compose.yaml
# DAGSTER_COMPOSE_PROJECT=dagster
# DAGSTER_USER_CODE_BUILD_PROJECT=datasyn
# DAGSTER_USER_CODE_IMAGE_NAME=dagster_user_code_image
