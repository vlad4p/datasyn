{
  "name": "put_object_from_path",
  "description": "Upload a file from disk (under STORAGE_MCP_READ_ROOT, default /data-local) to an object key. Uses multipart uploads for large files.",
  "arguments": {
    "type": "object",
    "properties": {
      "source_path": {
        "type": "string",
        "description": "Path under read root, e.g. /data-local/landing/uca/file.csv"
      },
      "key": {
        "type": "string",
        "description": "Object key, e.g. landing/censo_2022/uca/file.csv"
      },
      "bucket": {
        "default": "",
        "type": "string"
      },
      "content_type": {
        "default": "",
        "type": "string"
      },
      "create_bucket_if_missing": {
        "default": true,
        "type": "boolean"
      }
    },
    "required": ["source_path", "key"],
    "additionalProperties": false
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "result": {
        "type": "string"
      }
    },
    "required": ["result"],
    "x-fastmcp-wrap-result": true
  }
}
