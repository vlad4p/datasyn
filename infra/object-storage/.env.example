# MinIO object storage (infra/object-storage/docker-compose.yaml)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_BUCKET=data-local

# Clients on infra-datasynk use hostname datasyn-object-minio:9000 (compose network alias).
