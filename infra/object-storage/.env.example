MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_BUCKET=data-local
# Client apps on ``infra-datasynk`` should use host ``datasyn-object-minio:9000`` (see
# ``docker-compose.yaml`` network alias), not ``minio:9000``, if Langfuse is also on
# the network (duplicate ``minio`` DNS name).
# Dagster (``infra/dagster``) resolves ``MINIO_ACCESS_KEY``/``MINIO_SECRET_KEY`` from these
# when unset — keep the same values as here to avoid S3 SignatureDoesNotMatch on GetObject.
